{
  "name": "priority-web-ai-template",
  "version": "2.0.0",
  "private": true,
  "description": "AI-assisted Priority Web automation starter with Playwright and TypeScript.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:sanity": "playwright test tests/sanity",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed --project=chromium",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug --project=chromium",
    "test:unit": "node --test tests/unit/*.test.ts",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:sanity",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.19.2",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}
